<group name="mcp_lab,">
  <rule id="110500" level="0">
    <decoded_as>json</decoded_as>
    <field name="integration">^mcp_lab$</field>
    <description>MCP lab structured application event</description>
  </rule>
  <rule id="110501" level="8">
    <if_sid>110500</if_sid>
    <field name="mcp_action">^file_read$</field>
    <field name="sensitive">^yes$</field>
    <description>MCP lab tool read a designated dummy sensitive file</description>
  </rule>
  <rule id="110502" level="8">
    <if_sid>110500</if_sid>
    <field name="mcp_action">^process_start$</field>
    <field name="executable" type="pcre2">^/bin/(?:ba)?sh$</field>
    <description>MCP lab tool started a shell</description>
  </rule>
  <rule id="110503" level="10">
    <if_sid>110500</if_sid>
    <field name="mcp_action">^network_send$</field>
    <field name="sensitive">^yes$</field>
    <description>MCP lab tool sent designated dummy sensitive data</description>
  </rule>
</group>
